# Kopyalayın: cp .env.example .env   (.env dosyası .gitignore'dadır, GitHub'a yüklemeyin)
#
# Supabase paneli > Project Settings > API (veya Connect) bölümünden "caddeden" projesinin değerleri.
# Yalnızca URL ve publishable/anon anahtarı kullanılır. service_role / secret anahtarı ASLA buraya yazmayın:
# o anahtar yalnızca Edge Function'larda (Supabase tarafından otomatik sağlanır) kullanılır.
EXPO_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable-veya-anon-anahtar>

# İsteğe bağlı: şifre sıfırlama e-postasındaki kod uzunluğu (Supabase "Email OTP Length"; varsayılan 6)
# EXPO_PUBLIC_RECOVERY_OTP_LENGTH=6
